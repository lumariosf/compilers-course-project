{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GRAPH",
  "scopeName": "source.graph",
  "fileTypes": [
    "graph"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#graph-declaration"
    },
    {
      "include": "#nodetype-declaration"
    },
    {
      "include": "#func-declaration"
    },
    {
      "include": "#let-declaration"
    },
    {
      "include": "#typed-node"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#queries"
    },
    {
      "include": "#edge-fields"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.graph",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.graph",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.graph"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.graph"
            }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.graph",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "graph-declaration": {
      "patterns": [
        {
          "comment": "Graph G { ... }  ou  Graph G3 = G1.merge(...)",
          "match": "\\b(Graph)\\s+([A-Za-z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.graph.graph"
            },
            "2": {
              "name": "entity.name.type.class.graph"
            }
          }
        }
      ]
    },
    "nodetype-declaration": {
      "patterns": [
        {
          "match": "\\b(NodeType)\\s+([A-Za-z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.nodetype.graph"
            },
            "2": {
              "name": "entity.name.type.graph"
            }
          }
        },
        {
          "comment": "campo: Tipo dentro de um NodeType",
          "match": "\\b([A-Za-z][A-Za-z0-9_]*)\\s*(:)\\s*(?=(Number|String|Bool|Option)\\b)",
          "captures": {
            "1": {
              "name": "variable.other.property.graph"
            },
            "2": {
              "name": "punctuation.separator.key-value.graph"
            }
          }
        }
      ]
    },
    "func-declaration": {
      "patterns": [
        {
          "match": "\\b(func)\\s+([A-Za-z][A-Za-z0-9_]*)\\s*(\\()([^)]*)(\\))",
          "captures": {
            "1": {
              "name": "storage.type.function.graph"
            },
            "2": {
              "name": "entity.name.function.graph"
            },
            "3": {
              "name": "punctuation.definition.parameters.begin.graph"
            },
            "4": {
              "patterns": [
                {
                  "match": "[A-Za-z][A-Za-z0-9_]*",
                  "name": "variable.parameter.graph"
                },
                {
                  "match": ",",
                  "name": "punctuation.separator.comma.graph"
                }
              ]
            },
            "5": {
              "name": "punctuation.definition.parameters.end.graph"
            }
          }
        }
      ]
    },
    "let-declaration": {
      "patterns": [
        {
          "match": "\\b(let)\\s+([A-Za-z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.let.graph"
            },
            "2": {
              "name": "variable.other.constant.graph"
            }
          }
        }
      ]
    },
    "typed-node": {
      "patterns": [
        {
          "comment": "Node = ana : Pessoa { ... }",
          "match": "\\b([A-Za-z][A-Za-z0-9_]*)\\s*(:)\\s*([A-Za-z][A-Za-z0-9_]*)\\s*(?=\\{)",
          "captures": {
            "1": {
              "name": "variable.other.node.graph"
            },
            "2": {
              "name": "punctuation.separator.type.graph"
            },
            "3": {
              "name": "entity.name.type.graph"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.declaration.graph",
          "match": "\\b(Graph|Node|Edge|NodeType)\\b"
        },
        {
          "name": "storage.type.graph",
          "match": "\\b(let|func)\\b"
        },
        {
          "name": "keyword.control.conditional.graph",
          "match": "\\b(if|then|else)\\b"
        },
        {
          "name": "keyword.control.loop.graph",
          "match": "\\b(for|in)\\b"
        },
        {
          "name": "keyword.operator.logical.graph",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "constant.language.boolean.graph",
          "match": "\\b(True|False)\\b"
        },
        {
          "name": "support.function.builtin.graph",
          "match": "\\bprint\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.graph",
          "match": "\\b(Number|String|Bool|Option)\\b"
        }
      ]
    },
    "queries": {
      "patterns": [
        {
          "comment": "G.short_dist(...), G.filter(...), G.merge(...), G.short_path(...), G.connected(...)",
          "match": "(\\.)\\s*(short_dist|short_path|connected|filter|merge)\\b",
          "captures": {
            "1": {
              "name": "punctuation.accessor.graph"
            },
            "2": {
              "name": "support.function.query.graph"
            }
          }
        }
      ]
    },
    "edge-fields": {
      "patterns": [
        {
          "comment": "e.weight, e.origin, e.destination, e.type",
          "match": "(\\.)\\s*(weight|origin|destination|type)\\b",
          "captures": {
            "1": {
              "name": "punctuation.accessor.graph"
            },
            "2": {
              "name": "variable.language.edge-field.graph"
            }
          }
        },
        {
          "match": "(\\.)\\s*([A-Za-z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.graph"
            },
            "2": {
              "name": "variable.other.property.graph"
            }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b([A-Za-z][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.graph"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.edge.directed.graph",
          "match": "->"
        },
        {
          "name": "keyword.operator.edge.undirected.graph",
          "match": "--"
        },
        {
          "name": "keyword.operator.comparison.graph",
          "match": "==|!=|>=|<=|>|<"
        },
        {
          "name": "keyword.operator.filter-pipe.graph",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.assignment.graph",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.graph",
          "match": "[+\\-*/%]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.graph",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.graph",
          "match": ";"
        },
        {
          "name": "punctuation.separator.colon.graph",
          "match": ":"
        },
        {
          "name": "punctuation.section.block.graph",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.parens.graph",
          "match": "[()]"
        }
      ]
    }
  }
}
