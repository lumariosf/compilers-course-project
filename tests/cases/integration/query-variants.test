                        name: "north",
                        name: "south",
                        name: "east",
                ShortDist {
                        name: "north",
                        name: "east",
                ShortDist {
                        name: "south",
                        name: "north",
>2
>= 0

# A filter combines and, or, and not in one accepted expression.
