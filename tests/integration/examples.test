# Existing example: graph declaration followed by a short_dist query.
$ cargo run --quiet -- examples/grafo1.graph | sed -E 's/^[[:space:]]*//' | grep -E '^(Grafo|Consulta)\('
Grafo(
Consulta(
>2
>= 0

# Existing example: one graph with directed edges.
$ cargo run --quiet -- examples/grafo2.graph | sed -E 's/^[[:space:]]*//' | grep -E '^(Grafo|Consulta)\('
Grafo(
>2
>= 0

# Existing example: an empty graph declaration.
