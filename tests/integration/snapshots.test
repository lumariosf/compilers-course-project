# Snapshots cover small inputs with the complete AST; grep-based tests cover larger examples selectively.
# Complete AST snapshot for a graph with two nodes and one directed edge.
$ cargo run --quiet -- tests/integration/snapshot-two-nodes.graph
[
    Grafo(
        Grafo {
            nome: Ident {
                name: "Tiny",
                span: Span {
                    start: 6,
                    end: 10,
                },
            },
            membros: [
                Node(
                    Ident {
                        name: "a",
                        span: Span {
                            start: 25,
                            end: 26,
                        },
                    },
                ),
                Node(
                    Ident {
                        name: "b",
                        span: Span {
                            start: 28,
                            end: 29,
                        },
                    },
                ),
                Edge(
                    Aresta {
                        origem: Ident {
                            name: "a",
                            span: Span {
                                start: 42,
                                end: 43,
                            },
                        },
                        destino: Ident {
                            name: "b",
                            span: Span {
                                start: 47,
                                end: 48,
                            },
                        },
                        tipo: Direcionada,
                        peso: None,
                        span: Span {
                            start: 42,
                            end: 48,
                        },
                    },
                ),
            ],
            span: Span {
                start: 0,
                end: 50,
            },
        },
    ),
]
>2
>= 0

# Complete AST snapshot for a weighted directed edge.
$ cargo run --quiet -- tests/integration/snapshot-weighted-edge.graph
[
    Grafo(
        Grafo {
            nome: Ident {
                name: "Weight",
                span: Span {
                    start: 6,
                    end: 12,
                },
            },
            membros: [
                Node(
                    Ident {
                        name: "x",
                        span: Span {
                            start: 27,
                            end: 28,
                        },
                    },
                ),
                Node(
                    Ident {
                        name: "y",
                        span: Span {
                            start: 30,
                            end: 31,
                        },
                    },
                ),
                Edge(
                    Aresta {
                        origem: Ident {
                            name: "x",
                            span: Span {
                                start: 44,
                                end: 45,
                            },
                        },
                        destino: Ident {
                            name: "y",
                            span: Span {
                                start: 49,
                                end: 50,
                            },
                        },
                        tipo: Direcionada,
                        peso: Some(
                            2.5,
                        ),
                        span: Span {
                            start: 44,
                            end: 56,
                        },
                    },
                ),
            ],
            span: Span {
                start: 0,
                end: 58,
            },
        },
    ),
]
