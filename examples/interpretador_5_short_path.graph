// short_path: a lista de arestas do menor caminho (Dijkstra guardando o nó anterior de cada nó).
// As arestas saem na ordem do caminho e no sentido em que foram percorridas.

Graph Rede {
    Node = {a, b, c, d, e}
    Edge = { a -> b : 2, b -> c : 3, a -> c : 10, c -- d : 1, d -> e : 4 }
}

Rede.short_dist(a, e)     // 10
Rede.short_path(a, e)     // a -> b : 2 / b -> c : 3 / c -- d : 1 / d -> e : 4

// a aresta `c -- d` percorrida de d para c aparece como `d -- c`
let caminho = Rede.short_path(d, c);
print("d até c:", caminho);   // d até c: d -- c : 1

Rede.short_path(a, a)     // []  (caminho vazio: já está no destino)
