use crate::ast::*;
use crate::lexer::Token;

grammar;

extern {
    type Location = usize;
    type Error = String;

    enum Token {
        "Graph" => Token::Graph,
        "Node" => Token::Node,
        "Edge" => Token::Edge,
        "NodeType" => Token::NodeType,

        "for" => Token::For,
        "in" => Token::In,
        "and" => Token::And,
        "or" => Token::Or,
        "not" => Token::Not,

        "short_dist" => Token::ShortDist,
        "filter" => Token::Filter,
        "merge" => Token::Merge,

        "ident" => Token::Ident(<String>),
        "number" => Token::Number(<f64>),
        "string" => Token::Str(<String>),
        
        "True" => Token::True,
        "False" => Token::False,

        "->" => Token::ArrowDir,
        "--" => Token::ArrowUndir,

        "{" => Token::LBrace,
        "}" => Token::RBrace,
        "(" => Token::LParen,
        ")" => Token::RParen,
        "," => Token::Comma,
        ":" => Token::Colon,
        "." => Token::Dot,
        ";" => Token::Semicolon,
        "|" => Token::Pipe,
        "=" => Token::Equals,

        "==" => Token::EqEq,
        "!=" => Token::NotEq,
        ">=" => Token::Gte,
        "<=" => Token::Lte,
        ">" => Token::Gt,
        "<" => Token::Lt,

        "+" => Token::Plus,
        "-" => Token::Minus,
        "*" => Token::Star,
        "/" => Token::Slash,
        "%" => Token::Percent,
    }
}

// adiconado span que diz em que parte do texto o programa estava (usado pelo checker)


// ========== PROGRAMA

pub Programa: Vec<Item> = {
    <items:Item*> => items,
};

Item: Item = {
    <g:DeclaracaoGrafo> => Item::Grafo(g),
    <m:DeclaracaoGrafoMerge> => Item::GrafoMerge(m),
    <c:ComandoConsulta> => Item::Consulta(c),
};


Ident: Ident = {
    <l:@L> <name:"ident"> <r:@R> => Ident { name, span: Span { start: l, end: r } },
};

Comma<T>: Vec<T> = {
    <mut v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => { v.push(e); v }
    }
};

// ========== GRAFO

DeclaracaoGrafo: Grafo = {
    <l:@L> "Graph" <nome:Ident> "{" <itens:ItemGrafo*> "}" <r:@R> => Grafo {
        nome,
        membros: itens.into_iter().flatten().collect(),
        span: Span { start: l, end: r },
    },
};

DeclaracaoGrafoMerge: GrafoMerge = {
    <l:@L> "Graph" <nome:Ident> "=" <g1:Ident> "." "merge" "(" <g2:Ident> <pontes:("," <Ponte>)+> ")" <r:@R> => GrafoMerge {
        nome,
        g1,
        g2,
        pontes,
        span: Span { start: l, end: r },
    },
};

ItemGrafo: Vec<Membro> = {
    "Node" "=" "{" <ids:ListaIds> "}"
        => ids.into_iter().map(Membro::Node).collect(),
    "Node" "=" <id:Ident>
        => vec![Membro::Node(id)],
    "Edge" "=" "{" <es:Arestas> "}"
        => es.into_iter().map(Membro::Edge).collect(),
    "Edge" "=" <e:Aresta>
        => vec![Membro::Edge(e)],

        "Node" "=" <n:NoTipado>
        => vec![Membro::NodeTipado(n)],
    <t:TipoDecl>
        => vec![Membro::Tipo(t)],
};


// ========== NODES

ListaIds: Vec<Ident> = {
    <first:Ident> <rest:ListaIdsResto*>
        => { let mut v = vec![first]; v.extend(rest); v },
};

ListaIdsResto: Ident = {
    "," <id:Ident> => id,
};


// ========== EDGES

Aresta: Aresta = {
    <l:@L> <origem:Ident> <tipo:TipoAresta> <destino:Ident> <r:@R>
        => Aresta { origem, destino, tipo, peso: None, span: Span { start: l, end: r } },

    <l:@L> <origem:Ident> <tipo:TipoAresta> <destino:Ident> ":" <n:"number"> <r:@R>
        => Aresta { origem, destino, tipo, peso: Some(n), span: Span { start: l, end: r } },
};

ArestaResto: Aresta = {
    "," <e:Aresta> => e,
};


Arestas: Vec<Aresta> = {
    <first:Aresta> <rest:ArestaResto*>
        => { let mut v = vec![first]; v.extend(rest); v },
};

Peso: Option<f64> = {
    ":" <n:"number"> => Some(n),
    => None,
};

TipoAresta: TipoAresta = {
    "->" => TipoAresta::Direcionada,
    "--" => TipoAresta::NaoDirecionada,
};

// ========== TIPOS E ATRIBUTOS

TipoDecl: TipoDecl = {
    <l:@L> "NodeType" <nome:Ident> "{" <campos:Comma<Campo>> "}" <r:@R>
        => TipoDecl { nome, campos, span: Span { start: l, end: r } },
};

Campo: CampoDecl = {
    <nome:Ident> ":" <tipo:TipoAnotado> <r:@R> => {
        let span = Span { start: nome.span.start, end: r };
        CampoDecl { nome, tipo, span }
    },
};

TipoAnotado: TipoAnotado = {
    <n:Ident> => TipoAnotado::Nome(n),
    <n:Ident> "<" <a:TipoAnotado> ">"
        => TipoAnotado::Generico { nome: n, arg: Box::new(a) },
};

NoTipado: NoTipado = {
    <nome:Ident> ":" <tipo:Ident> "{" <atributos:Comma<Atributo>> "}" <r:@R> => {
        let span = Span { start: nome.span.start, end: r };
        NoTipado { nome, tipo, atributos, span }
    },
};

Atributo: Atributo = {
    <nome:Ident> ":" <valor:Expr> <r:@R> => {
        let span = Span { start: nome.span.start, end: r };
        Atributo { nome, valor, span }
    },
};

// ========== CONSULTAS

ComandoConsulta: ExpressaoConsulta = {
    <e:ExpressaoConsulta> ";"? => e,
};

ExpressaoConsulta: ExpressaoConsulta = {
    <grafo:Ident>
    <chamadas:ChamadaConsulta+>
    => {
        ExpressaoConsulta {
            grafo,
            chamadas,
        }
    },
};

ChamadaConsulta: Chamada = {
    "."
    <c:Chamada>
    => c,
};


Chamada: Chamada = {
    "short_dist"
    "(" <o:Ident> "," <d:Ident> ")"
    => {
        Chamada::ShortDist {
            origem: o,
            destino: d,
        }
    },

    "filter"
    "(" <f:Filtro> ")"
    => {
        Chamada::Filter {
            filtro: f,
        }
    },
};


// ========== FILTER

Filtro: Filtro = {
    "for"
    <v:Ident>
    "in"
    <fonte:Ident>
    "|"
    <cond:Expr>
    => {
        Filtro {
            variavel: v,
            fonte,
            condicao: cond,
        }
    },
};


// ========== MERGE

Ponte: Ponte = {
    <l:@L>
    <g_origem:Ident> "." <no_origem:Ident>
    <tipo:TipoAresta>
    <g_destino:Ident> "." <no_destino:Ident>
    <peso:Peso>
    <r:@R>
    => {
        Ponte {
            g_origem,
            no_origem,
            tipo,
            g_destino,
            no_destino,
            peso,
            span: Span { start: l, end: r },
        }
    },
};

// ========== EXPRESSÕES

Expr: Expr = {
    ExprOr,
};

ExprOr: Expr = {
    <l:ExprOr> "or" <r:ExprAnd> => Expr::binario(l, BinOp::Or, r),
    ExprAnd,
};

ExprAnd: Expr = {
    <l:ExprAnd> "and" <r:ExprNot> => Expr::binario(l, BinOp::And, r),
    ExprNot,
};

ExprNot: Expr = {
    <l:@L> "not" <e:ExprNot> <r:@R> => Expr {
        kind: ExprKind::Unario(UnOp::Not, Box::new(e)),
        span: Span { start: l, end: r },
    },
    ExprRel,
};

ExprRel: Expr = {
    <l:ExprAdd> <op:OpRel> <r:ExprAdd> => Expr::binario(l, op, r),
    ExprAdd,
};

ExprAdd: Expr = {
    <l:ExprAdd> <op:OpAdd> <r:ExprMul> => Expr::binario(l, op, r),
    ExprMul,
};

ExprMul: Expr = {
    <l:ExprMul> <op:OpMul> <r:ExprUnario> => Expr::binario(l, op, r),
    ExprUnario,
};

ExprUnario: Expr = {
    <l:@L> "-" <e:ExprPos> <r:@R> => Expr {
        kind: ExprKind::Unario(UnOp::Neg, Box::new(e)),
        span: Span { start: l, end: r },
    },
    ExprPos,
};

ExprPos: Expr = {
    <l:@L> <base:ExprPos> "." <campo:Ident> <r:@R> => Expr {
        kind: ExprKind::Acesso(Box::new(base), campo),
        span: Span { start: l, end: r },
    },
    ExprPrimaria,
};

ExprPrimaria: Expr = {
    <l:@L> <n:"number"> <r:@R> => Expr { kind: ExprKind::Numero(n), span: Span { start: l, end: r } },
    <l:@L> <s:"string"> <r:@R> => Expr { kind: ExprKind::Texto(s), span: Span { start: l, end: r } },
    <l:@L> "True" <r:@R> => Expr { kind: ExprKind::Bool(true), span: Span { start: l, end: r } },
    <l:@L> "False" <r:@R> => Expr { kind: ExprKind::Bool(false), span: Span { start: l, end: r } },
    <l:@L> <id:"ident"> <r:@R> => Expr { kind: ExprKind::Identificador(id), span: Span { start: l, end: r } },
    "(" <e:Expr> ")" => e,
};


// ========== OPERADORES

OpRel: BinOp = {
    "==" => BinOp::Eq,
    "!=" => BinOp::Neq,
    ">=" => BinOp::Gte,
    "<=" => BinOp::Lte,
    ">"  => BinOp::Gt,
    "<"  => BinOp::Lt,
};

OpAdd: BinOp = {
    "+" => BinOp::Add,
    "-" => BinOp::Sub,
};

OpMul: BinOp = {
    "*" => BinOp::Mul,
    "/" => BinOp::Div,
    "%" => BinOp::Mod,
};